    "content": "<!DOCTYPE html>\n<html>\n<head>\n<title>Countdown Timer</title>\n</head>\n<body>\n  <h1>Countdown Timer</h1>\n  <div id=\"timer\">\n    <span id=\"minutes\">00</span>:<span id=\"seconds\">00</span>\n  </div>\n  <!-- insert_here -->\n</body>\n</html>\n",
