    "type": "css",
    "content": "\nbody {\n    font-family: Arial, sans-serif;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    height: 100vh;\n    margin: 0;\n    background-color: #f0f0f0;\n}\n\n.timer-container {\n    background-color: #fff;\n    padding: 20px;\n    border-radius: 8px;\n    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);\n}\n\n#timer-display {\n    font-size: 2em;\n    font-weight: bold;\n    color: #333;\n}\n\n#minutes, #seconds {\n    padding: 5px;\n}\n",
