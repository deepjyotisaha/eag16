    color: #bb86fc;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
}

.timer-label {
    font-size: 0.8em;
    margin: 0 10px;
    color: #a7a7a7;
}

#countdown {
    display: flex;
    gap: 10px;
}

.time {
    display: flex;
    flex-direction: column;
