}

.time span {
    font-size: 1.2em;
    padding: 5px 10px;
    background-color: #212121;
    border-radius: 5px;
}

  </code></pre>

  <h2>JavaScript Code (script.js)</h2>
  <p>The JavaScript file contains the logic for the countdown timer, updating the display every second and handling the timer's completion.</p>
  <pre><code class="language-javascript">
// script.js

// Set the initial countdown time in minutes
let countdownMinutes = 5;

// Calculate the total seconds
let time = countdownMinutes * 60;

// Get the countdown display element from the HTML
const countdownDisplay = document.getElementById("countdown");

// Function to update the countdown display
function updateCountdown() {
  const minutes = Math.floor(time / 60);
  let seconds = time % 60;

  // Add a leading zero to seconds if it's less than 10
  seconds = seconds &lt; 10 ? '0' + seconds : seconds;

  // Update the HTML display with the current time
  countdownDisplay.textContent = `${minutes}:${seconds}`;

  // Decrement the time
  time--;

  // Check if the countdown has reached zero
  if (time &lt; 0) {
    clearInterval(countdownInterval);
    countdownDisplay.textContent = "TIME'S UP!";
    // You can add more actions here when the countdown finishes, like playing a sound or showing an alert.
  }
}

// Update the countdown every second
const countdownInterval = setInterval(updateCountdown, 1000);

// Initial call to set the display immediately
updateCountdown();
